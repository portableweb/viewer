{
  "productName": "PortableWeb",
  "version": "0.1.0",
  "identifier": "org.portableweb.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PortableWeb",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' pweb: asset: https://asset.localhost; script-src 'self' 'unsafe-inline' pweb:; style-src 'self' 'unsafe-inline' pweb:; img-src 'self' data: asset: pweb: blob:; font-src 'self' data: pweb:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pweb"],
        "name": "PortableWeb Bundle",
        "description": "PortableWeb interactive document",
        "mimeType": "application/vnd.portableweb+zip",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "single-instance": {}
  }
}
